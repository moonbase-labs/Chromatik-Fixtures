{
  "label": "Telecortex Panel Large Flat",
  "tags": [
    "triangle",
    "dome",
    "dome-large"
  ],
  "parameters": {
    "hostname": {
      "type": "string",
      "default": "127.0.0.1",
      "label": "Host",
      "description": "OPC receiver hostname or IP"
    },
    "port": {
      "type": "int",
      "default": 42069,
      "min": 1,
      "max": 65535,
      "label": "Port",
      "description": "OPC TCP/UDP port"
    },
    "opcChannel": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 255,
      "label": "OPC Channel",
      "description": "OPC channel (0-255)"
    },
    "opcOffset": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 65535,
      "label": "OPC Offset",
      "description": "Byte/pixel offset within the OPC channel"
    },
    "transport": {
      "type": "string",
      "default": "udp",
      "label": "Transport",
      "description": "OPC transport: udp or tcp"
    }
  },
  "output": {
    "protocol": "opc",
    "host": "$hostname",
    "port": "$port",
    "channel": "$opcChannel",
    "offset": "$opcOffset",
    "transport": "$transport",
    "byteOrder": "rgb"
  },
